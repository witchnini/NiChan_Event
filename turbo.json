{
  "$schema": "https://turborepo.dev/schema.json",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**",
        "*.tsbuildinfo"
      ]
    },
    "dev": {
      "persistent": true,
      "cache": false
    },
    "lint": {},
    "test": {},
    "check": {},
    "preview": {
      "persistent": true,
      "cache": false
    },
    "prisma:generate": {
      "cache": false
    },
    "prisma:migrate": {
      "cache": false
    },
    "prisma:studio": {
      "persistent": true,
      "cache": false
    },
    "db:seed": {
      "cache": false
    }
  }
}
