PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:8080

DATABASE_URL="postgresql://<USER>:<PASSWORD>@localhost:5432/NiChanDb"

# JWT - đổi sang chuỗi random dài trong production
JWT_SECRET=super-secret-change-me
JWT_EXPIRES_IN=7d

# Cloudinary - lấy từ https://console.cloudinary.com/
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Email / SMTP - để trống trong dev (tự dùng Ethereal)
# Production: điền thông tin SMTP thật (Gmail, SendGrid, Mailgun...)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="NiChan Events <noreply@nichan.vn>"

# App URL - URL frontend (dùng cho link trong email)
APP_URL=http://localhost:8080

# SePay Payment Gateway - Đăng ký tại https://sepay.vn
SEPAY_API_KEY=your_sepay_api_key
SEPAY_WEBHOOK_API_KEY=your_webhook_api_key
SEPAY_BANK_ACCOUNT=your_bank_account_number
SEPAY_BANK_CODE=MBBank
SEPAY_ACCOUNT_HOLDER=TEN_CHU_TAI_KHOAN
